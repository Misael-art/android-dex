# ~/.config/android-dex-flash/flash.env
# Configuração do android-dex-flash. Copie para o caminho acima e edite.
# Padrões conservadores: por padrão NADA é gravado no aparelho.

# --- Segurança (leia com atenção) ------------------------------------------
# DRY_RUN=1  => simula tudo, só mostra os comandos. É o padrão.
#             Use a flag --commit na linha de comando para gravar de verdade.
DRY_RUN="1"

# ALLOW_DESTRUCTIVE=0 bloqueia --commit até nas ações certificadas pelo driver.
# Root/firmware/restore continuam guiados e fail-closed mesmo quando este campo
# vale 1; só mude para liberar uma ação explicitamente suportada (ex.: unlock).
ALLOW_DESTRUCTIVE="0"

# Exige digitar "SIM" antes de qualquer gravação real.
REQUIRE_TYPED_CONFIRM="1"

# Bateria mínima (%) para permitir gravar. Bateria baixa durante flash brica.
MIN_BATTERY="40"

# --- Caminhos ---------------------------------------------------------------
# Onde ficam backups (ex.: boot.img salvo antes de rootar) e área de trabalho.
BACKUP_DIR=""
WORK_DIR=""

# Chaves públicas PEM aceitas para verificar firmware.manifest.sig.
# Adicionar uma chave aqui é uma decisão explícita de confiança.
TRUSTED_KEYS_DIR=""

# Serial obrigatório quando houver mais de um aparelho em adb/fastboot.
FLASH_DEVICE_SERIAL=""

# --- Insumos das ações (preenchidos por você conforme o modelo) -------------
# boot.img de ESTOQUE do firmware atual (para root/restauração):
BOOT_IMG=""

# Imagem já corrigida pelo Magisk (magisk_patched.img / AP_patched.tar):
PATCHED_IMG=""
# (opcional) sha256 esperado do PATCHED_IMG para verificação de integridade:
PATCHED_SHA256=""

# Motorola: código de desbloqueio recebido do site oficial:
UNLOCK_CODE=""
