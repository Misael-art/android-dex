#!/usr/bin/env bash
# android-dex-flash — manutenção de dispositivo Android (diagnóstico, desbloqueio
#   de bootloader, root via Magisk, flash de firmware) por orquestração das
#   ferramentas OFICIAIS de cada fabricante. Projeto irmão do android-dex.
#
# SEGURANÇA
#   - Só use no SEU aparelho.
#   - --dry-run é o PADRÃO: nada é gravado até você pedir --commit e confirmar.
#   - Root/unlock/flash podem BRICAR o aparelho e são frequentemente
#     IRREVERSÍVEIS (Knox, Play Integrity, garantia). Leia os avisos.
#
# Uso:
#   android-dex-flash info                 # Fase 0 — leitura pura, risco ZERO
#   android-dex-flash caps                 # o que é possível NESTE aparelho
#   android-dex-flash verify-firmware DIR  # assinatura/hash/modelo; não grava
#   android-dex-flash unlock [--commit]    # desbloqueia o bootloader (OEM-roteado)
#   android-dex-flash root   [--commit]    # patch boot.img c/ Magisk + flash
#   android-dex-flash flash-firmware PATH [--commit]   # grava firmware oficial
#   android-dex-flash reboot-bootloader    # reinicia p/ fastboot/download
#
# Flags globais:
#   --commit        executa de verdade (desliga o dry-run) — exige confirmação
#   --dry-run       força simulação (padrão)
#   --model NOME    trava o modelo esperado (guard rail contra firmware errado)
#   --yes           pula o "Enter para continuar" informativo (NÃO pula o SIM)
#
# Config: ~/.config/android-dex-flash/flash.env
# Log:    ~/.local/state/android-dex-flash/android-dex-flash.log
set -uo pipefail

# --- localizar libs ---------------------------------------------------------
_self="$(readlink -f "${BASH_SOURCE[0]}")"
_libdir=""
for _cand in \
  "$(dirname "$_self")/../lib" \
  "${XDG_DATA_HOME:-$HOME/.local/share}/android-dex-flash/lib" \
  "${XDG_DATA_HOME:-$HOME/.local/share}/android-dex/lib" \
  "/usr/local/share/android-dex-flash/lib"; do
  if [ -f "$_cand/common.sh" ] && [ -f "$_cand/flash-common.sh" ]; then _libdir="$_cand"; break; fi
  # permite common.sh compartilhado do android-dex + flash-common.sh local
  if [ -f "$_cand/flash-common.sh" ]; then _libdir="$_cand"; fi
done
[ -n "$_libdir" ] || { echo "FATAL: libs não encontradas (common.sh/flash-common.sh)" >&2; exit 1; }

# common.sh pode vir do próprio projeto ou do android-dex compartilhado
if [ -f "$_libdir/common.sh" ]; then . "$_libdir/common.sh"
elif [ -f "${XDG_DATA_HOME:-$HOME/.local/share}/android-dex/lib/common.sh" ]; then
  . "${XDG_DATA_HOME:-$HOME/.local/share}/android-dex/lib/common.sh"
else echo "FATAL: common.sh não encontrado" >&2; exit 1; fi
. "$_libdir/flash-common.sh"

# usa o log/estado próprios do flash
ADX_LOG_FILE="$ADXF_LOG_FILE"
adxf_load_config

# --- flags globais ----------------------------------------------------------
CMD=""
EXPECT_MODEL=""
ASSUME_YES=0
POSITIONAL=()

parse_globals() {
  while [ $# -gt 0 ]; do
    case "$1" in
      --commit)   DRY_RUN=0 ;;
      --dry-run)  DRY_RUN=1 ;;
      --model)    shift; EXPECT_MODEL="${1:-}" ;;
      --yes)      ASSUME_YES=1 ;;
      -h|--help)  usage; exit 0 ;;
      info|caps|verify-firmware|unlock|root|flash-firmware|reboot-bootloader|restore-boot)
        [ -z "$CMD" ] && CMD="$1" || POSITIONAL+=("$1") ;;
      *) POSITIONAL+=("$1") ;;
    esac
    shift
  done
}

usage() { sed -n '2,35p' "$_self" | sed 's/^# \{0,1\}//'; }

pause_info() {
  [ "$ASSUME_YES" = "1" ] && return 0
  [ -t 0 ] || return 0
  printf '%s[Enter para continuar, Ctrl-C para abortar]%s ' "$C_DIM" "$C_RESET" >&2
  read -r _ || true
}

# ---------------------------------------------------------------------------
# Fase 0 — device-info (risco ZERO): nunca grava nada.
# ---------------------------------------------------------------------------
cmd_info() {
  fp_collect
  printf '%s== android-dex-flash — diagnóstico (somente leitura) ==%s\n' "$C_BOLD" "$C_RESET"
  printf '  transporte      : %s\n' "$FP_TRANSPORT"
  if [ "$FP_TRANSPORT" = "none" ]; then
    log_warn "Nenhum aparelho visível."
    printf '\n  Conecte via USB e:\n'
    printf '   • sistema ligado: ative Depuração USB (adb)\n'
    printf '   • ou reinicie no bootloader: android-dex-flash reboot-bootloader\n'
    return 0
  fi
  printf '  fabricante      : %s\n' "${FP_MANUFACTURER:-?}"
  printf '  marca           : %s\n' "${FP_BRAND:-?}"
  printf '  modelo          : %s\n' "${FP_MODEL:-?}"
  printf '  codename        : %s\n' "${FP_DEVICE:-?}"
  printf '  Android / SDK   : %s / %s\n' "${FP_ANDROID:-?}" "${FP_SDK:-?}"
  printf '  patch segurança : %s\n' "${FP_PATCH:-?}"
  printf '  bootloader      : %s%s%s\n' "$C_BOLD" "$(unlock_label)" "$C_RESET"
  [ -n "${FP_VERIFIED_BOOT:-}" ] && printf '  verified boot   : %s\n' "$FP_VERIFIED_BOOT"
  [ -n "${FP_OEM_UNLOCK_ALLOWED:-}" ] && printf '  OEM unlock (dev): %s\n' "$(oem_unlock_label)"
  printf '  driver OEM      : %s\n' "$FP_OEM"
  printf '  ferramentas host: %s\n' "$(host_tools_line)"

  # Delegar o "o que é possível / o que se perde" ao driver do OEM.
  load_driver "$FP_OEM"
  printf '\n%s-- Capacidades e riscos (%s) --%s\n' "$C_BOLD" "$FP_OEM" "$C_RESET"
  driver_caps
  print_commit_policy
  printf '\n%sNada acima gravou no aparelho.%s Use "caps" p/ detalhes ou "unlock/root/flash-firmware" (com --dry-run).\n' "$C_DIM" "$C_RESET"
}

unlock_label() {
  case "$FP_BOOTLOADER_UNLOCKED" in
    sim) printf 'DESBLOQUEADO' ;;
    não) printf 'bloqueado' ;;
    *)   printf 'desconhecido (só o fastboot informa com certeza)' ;;
  esac
}
oem_unlock_label() {
  case "${FP_OEM_UNLOCK_ALLOWED:-}" in
    1) echo 'permitido (toggle "Desbloqueio de OEM" ligado)';;
    0) echo 'BLOQUEADO (ligue "Desbloqueio de OEM" nas Opções do desenvolvedor)';;
    *) echo '?';;
  esac
}
host_tools_line() {
  local out=""
  for t in adb fastboot heimdall lsusb sha256sum; do
    have "$t" && out+="${t} " || out+="${C_DIM}${t}✗${C_RESET} "
  done
  printf '%s' "$out"
}

cmd_caps() {
  fp_collect
  load_driver "$FP_OEM"
  printf '%s== Capacidades para %s (%s) ==%s\n' "$C_BOLD" "${FP_MODEL:-?}" "$FP_OEM" "$C_RESET"
  driver_caps
  print_commit_policy
}

cmd_verify_firmware() {
  local input="${POSITIONAL[0]:-}"
  fp_collect
  verify_firmware_descriptor "$input" >/dev/null
  log_ok "Descritor autenticado e compatível. Nenhuma partição foi gravada."
}

print_commit_policy() {
  local action label
  printf '\n%sPolítica de execução atual:%s\n' "$C_BOLD" "$C_RESET" >&2
  for action in unlock root flash-firmware restore-boot; do
    if declare -F driver_commit_supported >/dev/null 2>&1 && driver_commit_supported "$action"; then
      label="--commit disponível"
    else
      label="somente roteiro guiado (fail-closed)"
    fi
    printf '  • %-16s %s\n' "$action" "$label" >&2
  done
}

# ---------------------------------------------------------------------------
# Ações destrutivas — todas passam pelos guard rails + driver do OEM.
# ---------------------------------------------------------------------------
run_destructive() {
  local action="$1"; shift
  fp_collect
  load_driver "$FP_OEM"

  driver_warnings "$action"
  if [ "$DRY_RUN" != "1" ]; then
    if ! declare -F driver_commit_supported >/dev/null 2>&1 || ! driver_commit_supported "$action"; then
      die "Execução automática de '$action' não é suportada com segurança pelo driver '$FP_OEM'. Use --dry-run para obter o roteiro guiado e a ferramenta oficial do fabricante para concluir a gravação."
    fi
  fi
  guard_require_destructive_optin
  guard_verify_model "$EXPECT_MODEL"
  if [ "$action" = flash-firmware ] && [ -n "${1:-}" ]; then
    verify_descriptor_if_present "$1"
  fi

  if [ "$DRY_RUN" = "1" ]; then
    log_info "Modo dry-run: mostrando a sequência; nada será gravado."
  else
    warn_irreversible "Você pediu --commit: os comandos abaixo VÃO EXECUTAR." \
                      "Aparelho: ${FP_MODEL:-?} (${FP_OEM}). Ação: ${action}." \
                      "Isto pode brickar o aparelho e/ou é irreversível."
    guard_check_battery
    confirm_typed "SIM"
  fi

  case "$action" in
    unlock)          driver_unlock ;;
    root)            driver_root ;;
    flash-firmware)  driver_flash_firmware "$@" ;;
    restore-boot)    driver_restore_boot ;;
    *) die "Ação desconhecida: $action" ;;
  esac
}

cmd_reboot_bootloader() {
  fp_collect
  case "$FP_TRANSPORT" in
    adb)      run_or_echo adb -s "$FP_ADB_SERIAL" reboot bootloader ;;
    fastboot) log_info "Já em fastboot." ;;
    *)        die "Sem transferência adb. Reinicie manualmente no bootloader (combinação de teclas do aparelho)." ;;
  esac
}

# ---------------------------------------------------------------------------
main() {
  parse_globals "$@"
  case "${CMD:-info}" in
    info)              cmd_info ;;
    caps)              cmd_caps ;;
    verify-firmware)   cmd_verify_firmware ;;
    unlock)            run_destructive unlock ;;
    root)              run_destructive root ;;
    flash-firmware)    run_destructive flash-firmware "${POSITIONAL[@]:-}" ;;
    restore-boot)      run_destructive restore-boot ;;
    reboot-bootloader) cmd_reboot_bootloader ;;
    *)                 usage; exit 1 ;;
  esac
}
main "$@"
