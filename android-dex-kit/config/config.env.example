# ~/.config/android-dex/config.env
# Configuração do Android-DEX Kit. Copie para o caminho acima e edite.
# Todos os campos são opcionais — há defaults sensatos.

# --- Modo de operação -------------------------------------------------------
# auto   = detecta conservadoramente; cai para mirror quando houver dúvida
# dex    = força display virtual separado (experiência desktop, requer scrcpy >= 3.0
#          e Android com Desktop Mode; ideal em One UI 8 / Android 15+)
# mirror = espelha a tela real do aparelho
MODE="auto"

# --- Conexão ----------------------------------------------------------------
# auto = tenta USB e depois o DEVICE_IP salvo
# usb  = somente cabo
# wifi = somente sem fio (usa DEVICE_IP)
CONNECTION="auto"

# IP:porta do aparelho para Wi-Fi (preenchido pelo android-dex-connect).
DEVICE_IP=""

# Force um serial específico (útil com vários aparelhos). Vazio = auto.
DEVICE_SERIAL=""

# Porta escolhida pelo fluxo legado "adb tcpip". Depuração sem fio Android 11+
# usa mDNS para descobrir automaticamente sua porta aleatória de conexão.
ADB_TCP_PORT="5555"

# --- Vídeo / display do modo DeX -------------------------------------------
DISPLAY_RES="1920x1080"     # resolução do desktop virtual
DISPLAY_DPI="160"           # DPI (menor = mais "área"; 160 é confortável)
MAX_FPS="60"
VIDEO_BITRATE="8M"

# --- Áudio / energia --------------------------------------------------------
AUDIO="1"                   # 1 encaminha o áudio do aparelho (scrcpy 2.0+)
STAY_AWAKE="1"              # impede o aparelho de dormir enquanto conectado
TURN_SCREEN_OFF="0"         # (modo mirror) apaga a tela física ao iniciar

# --- Modo desktop (janelas livres) -----------------------------------------
# Descomente para sobrescrever o perfil automático do fabricante:
# ENABLE_FREEFORM_TWEAKS="1" # 1 habilita freeform/desktop no aparelho via adb
RESTORE_TWEAKS_ON_EXIT="0"  # 1 = restaura exatamente o estado anterior ao sair

# Decorações do display virtual (barra de navegação/launcher do sistema).
# 1 = padrão (mostra). 0 = --no-vd-system-decorations (use se a UI vier quebrada,
# comum em alguns aparelhos não-Samsung).
# VD_SYSTEM_DECORATIONS="1"

# Em aparelhos SEM launcher no display virtual (ex.: muitos não-Samsung/Pixel),
# o desktop abre vazio. Informe um pacote para abrir direto — pode ser um
# launcher de terceiros (ex.: org.fossify.home) ou um app específico.
# Deixe vazio em Samsung One UI 8+, onde o DeX aparece sozinho.
# (Se vazio, o app tenta abrir o "home" padrão do aparelho automaticamente.)
# START_APP=""

# XIAOMI / REDMI / POCO (MIUI/HyperOS): o modo desktop só funciona (freeform +
# controle por mouse/teclado) se você ligar em Opções do desenvolvedor:
#   "Depuração USB (Configurações de segurança)"  → exige conta Mi + internet,
#   e REINICIAR o aparelho. Sem isso o display virtual fica preto e sem controle;
#   use MODE="mirror" nesse meio-tempo. O android-dex avisa e cai para mirror
#   automaticamente quando detecta que o desktop não é viável.

# --- Resiliência ------------------------------------------------------------
RECONNECT="1"               # supervisor reconecta automaticamente em quedas
BACKOFF_BASE="2"            # base do backoff exponencial (s)
BACKOFF_CAP="30"            # teto do backoff (s)
HEALTHY_SESSION_SECONDS="15" # só zera o backoff após uma sessão estável
AUTO_DEX_MIN_SDK="35"        # SDK mínimo para o modo DeX automático

# --- Cosmético / extras -----------------------------------------------------
WINDOW_TITLE="Android DEX"
# Argumentos extras crus repassados ao scrcpy (avançado). Ex.:
# EXTRA_ARGS="--render-driver=opengl --keyboard=uhid"
EXTRA_ARGS=""

# 1 = registra comando e rc de operações não fatais que normalmente são quietas.
ADX_DEBUG="0"
