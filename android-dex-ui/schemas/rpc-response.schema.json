{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://android-dex.local/schemas/rpc-response.schema.json",
  "title": "Android-DEX JSON-RPC response",
  "type": "object",
  "additionalProperties": false,
  "required": ["jsonrpc", "id"],
  "properties": {
    "jsonrpc": {"const": "2.0"},
    "id": {"type": ["string", "integer", "null"]},
    "result": {},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "title", "detail", "recoverable", "actions"],
      "properties": {
        "code": {"type": "string", "pattern": "^E-[A-Z0-9-]+$"},
        "title": {"type": "string"},
        "detail": {"type": "string"},
        "recoverable": {"type": "boolean"},
        "actions": {"type": "array", "items": {"type": "string"}}
      }
    }
  },
  "oneOf": [
    {"required": ["result"], "not": {"required": ["error"]}},
    {"required": ["error"], "not": {"required": ["result"]}}
  ]
}
